# ==============================================================================
# DocQA Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in your values.
# All settings have sensible defaults — only API keys are required.

# --- LLM Provider ---
# Options: "openai", "anthropic", "ollama"
LLM_PROVIDER=openai

# --- API Keys ---
OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# --- Model Names ---
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-haiku-4-20250414
OLLAMA_MODEL=llama3.2
OLLAMA_BASE_URL=http://localhost:11434

# --- Embeddings ---
# Options: "openai", "sentence-transformers"
EMBEDDING_PROVIDER=openai
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
ST_EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Chunking ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# --- Retrieval ---
RETRIEVER_K=4
RETRIEVER_SEARCH_TYPE=similarity

# --- ChromaDB ---
# CHROMA_PERSIST_DIR=./chroma_db
# CHROMA_COLLECTION_NAME=docqa_default

# --- Refusal Thresholds ---
REFUSAL_SIMILARITY_THRESHOLD=0.3
REFUSAL_CONFIDENCE_THRESHOLD=0.5

# --- Observability ---
# LANGSMITH_API_KEY=your-langsmith-api-key-here
# LANGSMITH_PROJECT=docqa
LOG_LEVEL=INFO

# --- Server ---
API_HOST=0.0.0.0
API_PORT=8000
STREAMLIT_PORT=8501
